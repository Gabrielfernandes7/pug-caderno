    script(src="https://unpkg.com/aos@2.3.4/dist/aos.js")
    script.
      // Fallback de robustez: se o AOS não carregar, nada fica invisível.
      window.setTimeout(function () {
        if (typeof AOS === 'undefined') {
          var els = document.querySelectorAll('[data-aos]');
          for (var i = 0; i < els.length; i++) { els[i].removeAttribute('data-aos'); }
        }
      }, 2500);

      if (typeof AOS !== 'undefined') {
        AOS.init({ duration: 700, once: true, offset: 60, disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches });
      }

      // Revelação (flashcards e quiz): H1, H5, H9
      (function () {
        var btns = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        var status = document.getElementById('quiz-status');
        var quizBtns = btns.filter(function (b) { return b.classList.contains('btn') && b.tagName === 'BUTTON'; });

        function label(btn, open) {
          var icon = open ? 'fa-eye-slash' : 'fa-eye';
          var text = open ? 'Ocultar resposta' : 'Revelar resposta';
          if (btn.getAttribute('data-short') === 'true') { text = open ? 'Ocultar' : 'Revelar'; }
          btn.innerHTML = '<i class="fa-solid ' + icon + '" aria-hidden="true"></i> ' + text;
        }

        function updateStatus() {
          if (!status) { return; }
          var open = quizBtns.filter(function (b) { return b.getAttribute('aria-expanded') === 'true'; }).length;
          status.textContent = open + ' de ' + quizBtns.length + ' respostas reveladas';
        }

        btns.forEach(function (btn) {
          if (btn.classList.contains('btn-ghost') && !btn.closest('.quiz-item')) {
            btn.setAttribute('data-short', 'true');
          }
          btn.addEventListener('click', function () {
            var target = document.getElementById(btn.getAttribute('data-reveal'));
            if (!target) { return; }
            var isOpen = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!isOpen));
            target.hidden = isOpen;
            label(btn, !isOpen);
            updateStatus();
          });
        });

        var reset = document.getElementById('quiz-reset');
        if (reset) {
          reset.addEventListener('click', function () {
            quizBtns.forEach(function (b) {
              var target = document.getElementById(b.getAttribute('data-reveal'));
              b.setAttribute('aria-expanded', 'false');
              if (target) { target.hidden = true; }
              b.innerHTML = '<i class="fa-solid fa-eye" aria-hidden="true"></i> Revelar resposta';
            });
            updateStatus();
            if (quizBtns.length) { quizBtns[0].focus(); }
          });
        }

        // Flashcards usam rótulo curto
        Array.prototype.slice.call(document.querySelectorAll('.card [data-reveal]')).forEach(function (b) {
          b.innerHTML = '<i class="fa-solid fa-eye" aria-hidden="true"></i> Revelar';
        });

        updateStatus();
      })();

      // Tabela comparativa: realce por controle explícito (H3, H5)
      (function () {
        var toggle = document.getElementById('diff-toggle');
        var table = document.getElementById('diff-table');
        if (!toggle || !table) { return; }
        toggle.addEventListener('click', function () {
          var on = toggle.getAttribute('aria-pressed') === 'true';
          toggle.setAttribute('aria-pressed', String(!on));
          table.classList.toggle('show-diff', !on);
          toggle.innerHTML = !on
            ? '<i class="fa-solid fa-highlighter" aria-hidden="true"></i> Remover realce'
            : '<i class="fa-solid fa-highlighter" aria-hidden="true"></i> Destacar as diferenças';
        });
      })();

      // Playground numérico (C4 numérico-executável)
      (function () {
        var qEl = document.getElementById('q-range');
        var qOut = document.getElementById('q-out');
        var sumOut = document.getElementById('sum-out');
        var lastOut = document.getElementById('last-out');
        var barsEl = document.getElementById('bars');
        if (!qEl || !barsEl) { return; }

        var N = 24;

        function partial(q, n) {
          var sum = 0, prod = 1, terms = [];
          for (var i = 0; i < n; i++) {
            if (i > 0) { prod = prod * (1 + Math.pow(q, i - 1)); }
            var t = Math.pow(q, i * i) / (prod * prod);
            terms.push(t);
            sum += t;
          }
          return { sum: sum, terms: terms };
        }

        function render() {
          var q = parseFloat(qEl.value);
          var r = partial(q, N);
          qOut.textContent = q.toFixed(2);
          sumOut.textContent = r.sum.toFixed(6);
          lastOut.textContent = r.terms[r.terms.length - 1].toExponential(2);

          var max = 0;
          for (var i = 0; i < r.terms.length; i++) { if (r.terms[i] > max) { max = r.terms[i]; } }
          barsEl.innerHTML = '';
          r.terms.forEach(function (t, idx) {
            var d = document.createElement('div');
            d.className = 'bar';
            d.style.height = Math.max(1, (t / max) * 100) + '%';
            d.title = 'termo n=' + idx + ': ' + t.toExponential(3);
            barsEl.appendChild(d);
          });
        }

        qEl.addEventListener('input', render);
        render();
      })();